{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:3002"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sfera.example.com",
        "EXPO_PUBLIC_WS_URL": "wss://sfera.example.com"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sfera.example.com",
        "EXPO_PUBLIC_WS_URL": "wss://sfera.example.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
